# Django Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True

# Database Configuration (PostgreSQL with PostGIS)
DB_NAME=local_lend_a_hand
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Optional Google Maps API Key (Leaflet ESRI maps are used by default without any API key)
GOOGLE_MAPS_API_KEY=
